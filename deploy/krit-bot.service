[Unit]
Description=KRiT management API and MAX bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=krit
Group=krit
WorkingDirectory=/opt/krit-bot
EnvironmentFile=/opt/krit-bot/config/krit-bot.env
ExecStart=/opt/krit-bot/venv/bin/krit-bot
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
# The management API uses a strictly allowlisted sudo command to start the
# isolated root restore unit. NoNewPrivileges would block that escalation.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/krit-bot/data

[Install]
WantedBy=multi-user.target
