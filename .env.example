# Локально можно использовать SQLite. На сервере рекомендуется отдельная PostgreSQL-база.
DATABASE_URL=sqlite+aiosqlite:///./data/krit.db

# MAX Bot API
MAX_BOT_TOKEN=replace_me
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=replace_with_a_long_random_value
# Для BOT_MODE=webhook приложение проверяет эту подписку при каждом запуске.
# MAX_WEBHOOK_URL=https://example.ru/webhooks/max
JWT_SECRET=replace_with_a_long_random_value
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password_of_12_or_more_characters
BOT_MODE=polling

# Обязательная подписка при первичной регистрации в MAX (необязательно).
# Бот должен быть администратором канала, чтобы проверить участника.
# MAX_REQUIRED_CHANNEL_ID=-123456789
# MAX_REQUIRED_CHANNEL_LINK=https://max.ru/join/example
